# Copy this file to .env and adjust values as needed.

# Ollama settings
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180

# Whisper / Speech-to-Text settings
# Options for WHISPER_MODEL_SIZE include: tiny, base, small, medium
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech settings
# Options: auto | kokoro | piper | none
TTS_ENGINE=auto

# Kokoro TTS voice
KOKORO_VOICE=af_sarah

# Piper TTS model path
# Example:
# PIPER_MODEL_PATH=/path/to/en_US-lessac-medium.onnx
PIPER_MODEL_PATH=

# Maximum characters sent to TTS
MAX_TTS_CHARS=1200